(***
    The whole of trace theory, in two events.

    `a` and `b` are two strands side by side; `f` rewrites `a`, `g`
    rewrites `b`. The two events touch disjoint cells, so they are
    causally independent — and a trace is a 2-diagram, which does not
    record the order of independent events.

    Fire `f` then `g`, or `g` then `f`: the two interleavings build the
    *same* diagram, both equal to the single 0-composite `f #0 g`. The
    order lived only in the layering; the trace forgets it. This is the
    interchange law — and it is exactly Mazurkiewicz's commutation of
    independent actions, no narrative attached.

    Check it (`alifib repl examples/Independence.ali`):

        start Independence fg gf      (* target reached at step 0 *)
***)

@Type
Independence <<= {
    pt,

    (* Two independent strands, with the cell each is rewritten into. *)
    a: pt -> pt,
    b: pt -> pt,
    c: pt -> pt,
    d: pt -> pt,

    (* The two events: one per strand, with disjoint support. *)
    f: a -> c,
    g: b -> d
}

(***
    The two interleavings of the run `a b => c d`, one event per layer.
    They differ only in which event fires first, and so — by interchange
    — they are equal as diagrams.
***)
@Independence
(* f first, then g *)
let fg = (f #0 b) #1 (c #0 g),

(* g first, then f *)
let gf = (a #0 g) #1 (f #0 d)
