@Type
O1 <<= {
    s0, t0,
    top : s0 -> t0,
},
O2 <<= {
    s0, t0,
    s1 : s0 -> t0, t1 : s0 -> t0,
    top : s1 -> t1,
},
O3 <<= {
    s0, t0,
    s1 : s0 -> t0, t1 : s0 -> t0,
    s2 : s1 -> t1, t2 : s1 -> t1,
    top : s2 -> t2,
},

Whisker2 <<= {
    attach x :: O2,
    attach y :: O1 along [ s0 => x.t0 ],
    let w = x.top #0 y.top,
    let total F :: O2 = [
        top => w
    ]
},

Whisker3 <<= {
    attach x :: O3,
    attach y :: O1 along [ s0 => x.t0 ],
    let w = x.top #0 y.top,
    let total F :: O3 = [
        top => w
    ]
},
